{
  "expo": {
    "name": "teresaNails",
    "slug": "teresaNails",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "teresanails",
    "userInterfaceStyle": "light",
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCE7EF",
          "image": "./assets/images/Teresa_Silva_logo_transparente.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
