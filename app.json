{
  "expo": {
    "name": "teresaNails",
    "slug": "teresaNails",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "teresanails",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.denissoney.teresanails",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCE7EF",
          "image": "./assets/images/Teresa_Silva_logo_transparente.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "da199440-aed9-4e60-9b43-5046681f09f0"
      }
    }
  }
}
